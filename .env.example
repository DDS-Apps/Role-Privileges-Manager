# Copy to .env and fill in values. Never commit .env.

# Outbound IT fulfillment email (Office 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-mailbox@dds.sa
SMTP_PASS=your-app-password
SMTP_FROM=your-mailbox@dds.sa

# Inbound ServiceDesk replies — Microsoft Graph (recommended)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_MAILBOX=sales@dds.sa

# Legacy fallback: IMAP (optional if Graph is configured)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IT_EMAIL_POLL_INTERVAL_MS=60000
IT_EMAIL_FROM_ALLOWLIST=support

# App
PORT=5000
SESSION_SECRET=change-me-in-production
