# =============================================================================
# Role Privileges Manager — copy to .env and fill in values. Never commit .env
# =============================================================================
#
# Production deploy:
#   1. Copy this file to .env on the server
#   2. Fill ALL values below (especially VITE_* before npm run build)
#   3. npm run build
#   4. npm start  (or node dist/index.cjs)
#
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
PORT=6500
# IIS/ARR forwards to Node over HTTP — keep false unless ARR sends X-Forwarded-Proto: https
COOKIE_SECURE=false
TRUST_PROXY=1
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters
# Optional separate secret for approval email JWT links (defaults to SESSION_SECRET)
# APPROVAL_EMAIL_SECRET=another-long-random-string-at-least-32-characters
APP_PUBLIC_URL=https://your-production-hostname

# --- Microsoft SSO (Entra ID) — server runtime --------------------------------
# Use the SPA app registration client id (Authentication → Single-page app).
# Often DIFFERENT from GRAPH_CLIENT_ID (Graph uses a confidential app + secret).
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-sso-spa-client-id
# AZURE_AD_AUDIENCE=your-sso-spa-client-id

# --- Microsoft SSO — client build-time (VITE_* baked in at npm run build) ---
# Must match the SPA app above. Redirect URI must be registered in Entra.
VITE_AZURE_AD_TENANT_ID=your-tenant-id
VITE_AZURE_AD_CLIENT_ID=your-sso-spa-client-id
VITE_AZURE_AD_REDIRECT_URI=https://your-production-hostname/login

# --- Outbound email (approver notifications + IT Support tickets) --------------
# Option A — Office 365 SMTP (requires mailbox app password):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sales@dds.sa
SMTP_PASS=your-mailbox-app-password
SMTP_FROM=sales@dds.sa
# Force Graph instead of SMTP (useful when SMTP auth is blocked but Graph Mail.Send works):
# OUTBOUND_MAIL=graph
#
# Option B — If SMTP fails/unavailable, Graph sendMail is used when Graph is configured below.
# Graph app needs Application permission: Mail.Send (+ admin consent) on the mailbox.

# --- Inbound ServiceDesk replies — Microsoft Graph (recommended) --------------
# Reads sales@dds.sa inbox for ManageEngine ticket ack / resolved emails.
# App registration needs Application permission: Mail.Read (+ admin consent).
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-graph-app-client-id
GRAPH_CLIENT_SECRET=your-graph-client-secret
GRAPH_MAILBOX=sales@dds.sa

# --- IT email poller ----------------------------------------------------------
IT_EMAIL_POLL_INTERVAL_MS=60000
IT_EMAIL_LOOKBACK_DAYS=30
IT_EMAIL_UNREAD_ONLY=false
IT_EMAIL_FROM_ALLOWLIST=support,dallah,servicedesk

# --- Legacy IMAP fallback (only if Graph is NOT configured) -------------------
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=sales@dds.sa
# IMAP_PASS=your-mailbox-app-password

# --- Optional: Postgres (not used for main app data yet) ----------------------
# DATABASE_URL=postgres://user:password@localhost:5432/rpm
